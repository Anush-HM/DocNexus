# ── Dependencies ──
node_modules/
backend/node_modules/
frontend/node_modules/

# ── Lockfiles are fine to commit (they keep installs reproducible) ──
# package-lock.json is intentionally NOT ignored

# ── Environment secrets ──
.env
backend/.env
frontend/.env
*.env.local

# ── Uploaded files (user PDFs - don't commit real student data) ──
backend/uploads/*
!backend/uploads/.gitkeep

# ── Logs ──
*.log
npm-debug.log*
logs/

# ── OS / editor junk ──
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ── Build artifacts (if you ever add a bundler) ──
dist/
build/

# ── nodemon / runtime ──
*.pid

# ── Misc local-only files ──
*.local