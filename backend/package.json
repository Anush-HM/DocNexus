{
  "name": "docnexus-backend",
  "version": "1.0.0",
  "description": "DocNexus - AI-Powered Knowledge Fusion & Learning Platform (Backend)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
