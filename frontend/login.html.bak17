<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in — DocNexus</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family:'DM Sans',sans-serif; }
    .font-syne { font-family:'Syne',sans-serif; }
    .bg-grid { background-image:linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px); background-size:40px 40px; }
  </style>
</head>
<body class="bg-[#0a0a0f] text-white min-h-screen relative">
  <div class="bg-grid fixed inset-0 pointer-events-none"></div>
  <div class="relative z-10 min-h-screen flex items-center justify-center px-6">
    <div class="w-full max-w-[400px]">
      <div class="flex items-center justify-center gap-2.5 mb-8">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-[#7c6fff] to-[#a78bfa] flex items-center justify-center">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/></svg>
        </div>
        <span class="font-syne text-[20px] font-extrabold tracking-tight">Doc<span class="text-[#a78bfa]">Nexus</span></span>
      </div>

      <div class="bg-white/[0.03] border border-white/[0.07] rounded-2xl p-7">
        <div class="flex gap-1 p-1 bg-white/[0.04] rounded-xl mb-6">
          <button id="tabLogin" onclick="setMode('login')" class="flex-1 text-[13px] font-semibold py-2 rounded-lg transition-colors">Sign in</button>
          <button id="tabRegister" onclick="setMode('register')" class="flex-1 text-[13px] font-semibold py-2 rounded-lg transition-colors">Create account</button>
        </div>

        <form id="authForm" onsubmit="submitForm(event)" class="space-y-4">
          <div id="nameRow" class="hidden">
            <label class="block text-[11px] text-zinc-500 uppercase tracking-widest font-bold mb-1.5">Name (optional)</label>
            <input id="name" type="text" autocomplete="name" class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-4 py-3 text-[14px] outline-none focus:border-[#7c6fff]/50">
          </div>
          <div>
            <label class="block text-[11px] text-zinc-500 uppercase tracking-widest font-bold mb-1.5">Email</label>
            <input id="email" type="email" required autocomplete="email" class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-4 py-3 text-[14px] outline-none focus:border-[#7c6fff]/50">
          </div>
          <div>
            <label class="block text-[11px] text-zinc-500 uppercase tracking-widest font-bold mb-1.5">Password</label>
            <input id="password" type="password" required minlength="8" autocomplete="current-password" class="w-full bg-white/[0.04] border border-white/10 rounded-xl px-4 py-3 text-[14px] outline-none focus:border-[#7c6fff]/50">
            <div id="pwHint" class="hidden text-[11px] text-zinc-600 mt-1.5">At least 8 characters.</div>
          </div>
          <div id="err" class="hidden text-[13px] text-red-400"></div>
          <button id="submitBtn" type="submit" class="w-full bg-gradient-to-r from-[#7c6fff] to-[#a78bfa] text-white font-semibold text-[14px] py-3 rounded-xl hover:opacity-90 transition-opacity disabled:opacity-50">Sign in</button>
        </form>
      </div>
      <p class="text-center text-[12px] text-zinc-600 mt-5">Your notes are saved to your account, so you can open them any time.</p>
    </div>
  </div>

  <script>
    const IS_LOCAL_DEV = !location.protocol.startsWith('http') ||
      (['localhost', '127.0.0.1'].includes(location.hostname) && location.port !== '5000');
    const AUTH_BASE = window.DOCNEXUS_API ? window.DOCNEXUS_API.replace(/\/projects\/?$/, '/auth')
      : (IS_LOCAL_DEV ? 'http://localhost:5000/api/auth' : `${location.origin}/api/auth`);
    const next = new URLSearchParams(location.search).get('next');
    let mode = 'login';

    // already signed in -> straight to the projects list
    try { const a = JSON.parse(localStorage.getItem('docnexus_auth')); if (a && a.token) location.replace(next || 'projects.html'); } catch (e) {}

    function setMode(m) {
      mode = m;
      const on = 'bg-[#7c6fff]/20 text-[#c4b5fd]', off = 'text-zinc-500 hover:text-zinc-300';
      tabLogin.className = `flex-1 text-[13px] font-semibold py-2 rounded-lg transition-colors ${m === 'login' ? on : off}`;
      tabRegister.className = `flex-1 text-[13px] font-semibold py-2 rounded-lg transition-colors ${m === 'register' ? on : off}`;
      nameRow.classList.toggle('hidden', m !== 'register');
      pwHint.classList.toggle('hidden', m !== 'register');
      password.autocomplete = m === 'register' ? 'new-password' : 'current-password';
      submitBtn.textContent = m === 'register' ? 'Create account' : 'Sign in';
      err.classList.add('hidden');
    }
    setMode('login');

    async function submitForm(e) {
      e.preventDefault();
      err.classList.add('hidden');
      submitBtn.disabled = true;
      try {
        const res = await fetch(`${AUTH_BASE}/${mode}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: name.value, email: email.value, password: password.value }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Something went wrong');
        localStorage.setItem('docnexus_auth', JSON.stringify({ token: data.token, user: data.user }));
        location.href = next || 'projects.html';
      } catch (ex) {
        err.textContent = ex.message === 'Failed to fetch' ? "Can't reach the backend. Is it running (npm run dev)?" : ex.message;
        err.classList.remove('hidden');
        submitBtn.disabled = false;
      }
    }
  </script>
</body>
</html>
